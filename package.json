{
  "name": "pull-ups-timer",
  "version": "1.0.0",
  "description": "6-minute timer with counter",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:sam": "sam build && sam local start-api --port 7777 --env-vars sam-local-env.json",
    "start:sam:watch": "sam build && sam local start-api --port 7777 --env-vars sam-local-env.json --warm-containers EAGER",
    "start:ui": "npx http-server public -p 3000 -c-1",
    "start:dev": "echo '⚠️  Run in 2 terminals:\\nTerminal 1: npm run start:sam:watch\\nTerminal 2: npm run start:ui'",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/"
    ]
  }
}
